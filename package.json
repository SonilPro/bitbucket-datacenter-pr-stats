        "react-dom": "16.12.0"
    },
    "devDependencies": {
        "@atlassian/browserslist-config-server": "^0.3.2",
        "@atlassian/clientside-extensions-schema": "^3.0.1",
        "@atlassian/clientside-extensions-webpack-plugin": "^3.0.1",
        "@atlassian/i18n-properties-loader": "^1.0.13",
        "@babel/core": "^7.24.7",
        "@babel/eslint-parser": "^7.24.7",
        "@babel/plugin-transform-runtime": "^7.24.7",
        "@babel/preset-env": "^7.24.7",
        "@babel/preset-react": "^7.24.7",
        "@babel/runtime": "^7.24.7",
        "@eslint/compat": "^1.1.0",
        "@eslint/eslintrc": "^3.1.0",
        "@eslint/js": "^9.6.0",
        "@playwright/test": "^1.45.3",
        "@testing-library/jest-dom": "^6.4.6",
        "@types/node": "^22.0.1",
        "atlassian-webresource-webpack-plugin": "^6.0.3",
        "babel-jest": "^29.7.0",
        "babel-loader": "^9.1.3",
        "css-loader": "^7.1.2",
        "duplicate-package-checker-webpack-plugin": "^3.0.0",
        "eslint": "^9.6.0",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-config-prettier": "^9.1.0",
        "eslint-import-resolver-webpack": "^0.13.8",
        "eslint-plugin-import": "2.29.1",
        "eslint-plugin-jsx-a11y": "^6.9.0",
        "eslint-plugin-prettier": "^5.1.3",
        "eslint-plugin-react": "^7.34.3",
        "eslint-plugin-react-hooks": "^4.6.2",
        "glob": "^11.0.0",
        "globals": "^15.8.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "jest-junit": "^16.0.0",
        "mini-css-extract-plugin": "^2.9.0",
        "mkdirp": "^3.0.1",
        "network": "^0.7.0",
        "pptr-testing-library": "^0.8.0",
        "prettier": "^3.3.2",
        "react-hot-loader": "^4.13.1",
        "start-server-and-test": "^2.0.5",
        "style-loader": "^4.0.0",
        "terser-webpack-plugin": "2.2.1",
        "webpack": "^5.92.1",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^5.0.4",
        "webpack-merge": "^6.0.1",
        "yargs": "^17.7.2"
    },
    "optionalDependencies": {
        "fsevents": "^2.3.3"
    },
    "scripts": {
        "watch": "NODE_OPTIONS=\"--openssl-legacy-provider\" NODE_ENV=\"development\" webpack --watch --config ./config/webpack.config.js",
        "start": "atlas-package -DskipTests -Pwatch-mode && npm run dev-server ",
        "start:bitbucket": "atlas-run -DskipTests -DskipNpmInstall",
        "build": "atlas-package -DskipTests",
        "build:prod": "NODE_OPTIONS=\"--openssl-legacy-provider\" NODE_ENV=\"production\" webpack --config ./config/webpack.config.js",
        "build:dev": "NODE_OPTIONS=\"--openssl-legacy-provider\" NODE_ENV=\"development\" webpack --config ./config/webpack.config.js --mode=development",
        "dev-server": "webpack-dev-server --config ./config/webpack.config.js --mode=development --env=dev-server",
        "lint": "eslint './**/*.{js,js,jsx}'",
        "test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --config ./config/jest/jest.config.js",
        "test:watch": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --config ./config/jest/jest.config.js --watch",
        "test:ci": "start-server-and-test start:bitbucket http://localhost:7990/bitbucket/rest/api/latest/application-properties test:e2e:ui",
        "test:e2e:ui": "npx playwright test --ui"
    },
    "browserslist": [
        "extends @atlassian/browserslist-config-server"
    ],
    "prettier": {
        "tabWidth": 4,
        "semi": true,
        "trailingComma": "es5",
        "singleQuote": true,
        "printWidth": 100
    }
}
